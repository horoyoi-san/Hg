  int32 end = 4;
}



message Header {
  Version version = 1;
  MessageType messageType = 2;
  uint32 seqId = 3;
}



message AuthRequest {
  string token = 1;
  string uid = 2;
  string did = 3;
  string appId = 4;
  string os = 5;
  string osVersion = 6;
  string appVersion = 7;
  string logSdkVersion = 8;
  string deviceModel = 9;
  string networkType = 10;
  string deviceName = 11;
  string serverName = 12;
  string serverChannel = 13;
  int64 gameLaunchTime = 14;
  string accountAlias = 15;
  string devVersion = 16;
  map<string, string> extra = 17;
}



message AuthResponse {
  ResponseStatus status = 1;
  string message = 2;
  EncryptType encryptType = 3;
  string key = 4;
}



message LogIntParam {
  int64 val = 1;
  int32 index = 2;
}



message LogFloatParam {
  float val = 1;
  int32 index = 2;
}



message LogDoubleParam {
  double val = 1;
  int32 index = 2;
}



message LogBoolParam {
  string val = 1;
  int32 index = 2;
}



message LogStringParam {
  string val = 1;
  int32 index = 2;
}



message LogMessage {
  string logTemplate = 1;
  uint32 templateHash = 2;
  LogLevel logLevel = 3;
  int32 channel = 4;
  int64 time = 5;
  int64 roleId = 11;
  uint32 frameCount = 12;
  float playerPosX = 13;
  float playerPosY = 15;
  float playerPosZ = 16;
  int32 playerPing = 14;
  repeated LogIntParam paramsIntList = 6;
  repeated LogFloatParam paramsFloatList = 7;
  repeated LogDoubleParam paramsDoubleList = 8;
  repeated LogBoolParam paramsBoolList = 9;
  repeated LogStringParam paramsStringList = 10;
}



message LogMessageResponse {
  ResponseStatus status = 1;
  string message = 2;
  uint32 templateHash = 3;
}


